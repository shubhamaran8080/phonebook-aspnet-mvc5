## Ignore Visual Studio temporary files, build results, and
## files generated by various Visual Studio designers.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
*.trs
*.coverage
*.coveragexml

# NuGet
packages/
!packages/repositories.config

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# SQL Server
*.mdf
*.ldf

# IIS Express
*.vsconfig

# Docker - local environment file (contains real credentials, never commit)
.env
*.env
!.env.example

# Local ASP.NET MVC configuration - contains database credentials
Phonebook.Web/Web.config
Phonebook.Web/Web.config.local-backup
