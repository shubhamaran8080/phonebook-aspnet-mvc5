# ---------------------------------------------------------------------------
# Environment template for the Phonebook Docker setup.
#
# Copy this file to ".env" (which is git-ignored) and replace every CHANGE_ME
# placeholder with your real local values. NEVER commit real credentials.
#
#   copy .env.example .env
# ---------------------------------------------------------------------------

# Connection string the containerized web app uses to reach SQL Server.
# A container cannot use "localhost" for the Windows host - use
# host.docker.internal (Docker Desktop) or the SQL Server host name / IP.
# User ID and Password below are PLACEHOLDERS.
DEFAULT_CONNECTION_STRING=Server=host.docker.internal,1433;Initial Catalog=PhonebookAspNetMVC47;User ID=CHANGE_ME;Password=CHANGE_ME;MultipleActiveResultSets=True;Encrypt=False;TrustServerCertificate=True

# Demo-user seeding (maps to the DemoUserEnabled appSetting).
# Leave "false" for anything other than local development.
DEMO_USER_ENABLED=false
DEMO_USER_USERNAME=CHANGE_ME
DEMO_USER_EMAIL=CHANGE_ME
DEMO_USER_PASSWORD=CHANGE_ME

# Container isolation mode: "process" (default) or "hyperv".
# Use "hyperv" on Windows 10/11 Pro/Enterprise when the host OS build differs
# from the image OS build (windowsservercore-ltsc2022 = build 20348).
DOCKER_ISOLATION=process
