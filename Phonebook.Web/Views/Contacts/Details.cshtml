@model Phonebook.Web.Models.ViewModels.ContactFormViewModel
@{
    ViewBag.Title = "Contact Details";
    ViewBag.PageTitle = "Contact Details";
}

<div class="page">
    <header class="page-header">
        <div>
            @Html.ActionLink("← Back to contacts", "Index", "Contacts", null, new { @class = "link", style = "font-weight: 500" })
            <h1 style="margin-top: 8px">Contact Details</h1>
        </div>
    </header>

    <div class="card" style="margin-bottom: 20px">
        <div class="profile-header">
            <span class="avatar large">@(Model.Name.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "?")</span>
            <div>
                <h2>@Model.Name</h2>
                <p class="subtitle">@Model.PhoneNumber</p>
            </div>
        </div>
    </div>

    <div class="card form-card">
        <div class="card-header">
            <h2>Edit Contact</h2>
        </div>
        @using (Html.BeginForm("Edit", "Contacts", FormMethod.Post, new { @class = "form-grid", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="field">
                <span>Name *</span>
                @Html.TextBoxFor(m => m.Name, new { @class = "input", maxlength = "255" })
                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "field-error" })
            </div>

            <div class="field">
                <span>Phone number * <span class="hint">(E.164 format, e.g. +1234567890)</span></span>
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "input", title = "Phone number in E.164 format, e.g. +1234567890" })
                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "field-error" })
            </div>

            <div class="field">
                <span>Email <span class="hint">(optional)</span></span>
                @Html.TextBoxFor(m => m.Email, new { @class = "input", type = "email" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
            </div>

            <div class="field">
                <span>Address <span class="hint">(optional)</span></span>
                @Html.TextAreaFor(m => m.Address, new { @class = "input" })
                @Html.ValidationMessageFor(m => m.Address, "", new { @class = "field-error" })
            </div>

            <div style="display: flex; gap: 10px">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <button type="reset" class="btn">Reset</button>
                @Html.ActionLink("Back to list", "Index", "Contacts", null, new { @class = "btn" })
            </div>
        }
    </div>

    <div class="card" style="margin-top: 20px;">
        <div class="card-header">
            <h2>Contact Information</h2>
        </div>
        <div class="profile-field">
            <span class="k">Created</span>
            <span class="v">@Model.CreatedAt.ToString("MMMM d, yyyy HH:mm")</span>
        </div>
        <div class="profile-field">
            <span class="k">Phone</span>
            <span class="v">@Model.PhoneNumber</span>
        </div>
        <div class="profile-field">
            <span class="k">Email</span>
            <span class="v">@(Model.Email ?? "—")</span>
        </div>
        <div class="profile-field">
            <span class="k">Address</span>
            <span class="v">@(Model.Address ?? "—")</span>
        </div>
    </div>
</div>
