@{
    ViewBag.Title = "Page not found";
    Layout = null;
    Response.StatusCode = 404;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Phonebook</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-brand">
                <div class="login-logo">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                </div>
                <h1>Page not found</h1>
                <p>The page or contact you were looking for does not exist.</p>
            </div>
            <div class="page-actions">
                @if (User.Identity.IsAuthenticated)
                {
                    @Html.ActionLink("Go to Dashboard", "Index", "Dashboard", null, new { @class = "btn btn-primary btn-block" })
                    <div style="height: 10px"></div>
                    @Html.ActionLink("Back to Contacts", "Index", "Contacts", null, new { @class = "btn btn-block" })
                }
                else
                {
                    @Html.ActionLink("Sign in", "Login", "Account", null, new { @class = "btn btn-primary btn-block" })
                }
            </div>
        </div>
    </div>
</body>
</html>
