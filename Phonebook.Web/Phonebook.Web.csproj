  <!--
    The Roslyn compiler files that ASP.NET CodeDom uses at runtime.
    The CodeDom package copies them into _PublishedWebsites\Phonebook.Web\bin\roslyn
    (because WebProjectOutputDir resolves that way), but the provider looks for them
    in bin\roslyn. This target copies them into the real output folder.
  -->
  <Target Name="CopyPhonebookRoslynToBin" AfterTargets="Build">
    <ItemGroup>
      <_PhonebookRoslynSrc Include="$(MSBuildProjectDirectory)\_PublishedWebsites\$(MSBuildProjectName)\roslyn\**\*"
                          Condition="Exists('$(MSBuildProjectDirectory)\_PublishedWebsites\$(MSBuildProjectName)\roslyn')" />
      <_PhonebookRoslynSrc Include="$(MSBuildProjectDirectory)\_PublishedWebsites\$(MSBuildProjectName)\bin\roslyn\**\*"
                          Condition="Exists('$(MSBuildProjectDirectory)\_PublishedWebsites\$(MSBuildProjectName)\bin\roslyn')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PhonebookRoslynSrc)"
          DestinationFiles="@(_PhonebookRoslynSrc->'$(OutDir)roslyn\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'@(_PhonebookRoslynSrc)' != ''" />
  </Target>
